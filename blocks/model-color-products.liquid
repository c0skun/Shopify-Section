{%- liquid
  # Aynı modelin diğer renklerini "Related products" görünümünde (temanın ürün kartıyla) gösterir.
  #
  # Gruplama kaynakları (ilk dolu olan kullanılır):
  #   1. custom.model_group / custom.custom_model_group -> metaobject (Model Group) -> products | model_code
  #   2. custom.color_siblings  -> ürün listesi metafield'ı (list.product_reference)
  #   3. custom.model_variants  -> "handle1,handle2,..." metin metafield'ı
  #   4. Ürün etiketi "model:<ad>" -> collections['<önek><ad>'] (etikete göre otomatik koleksiyon)

  assign st = block.settings

  assign p = closest.product
  if p == blank
    assign p = product
  endif

  assign siblings = null
  assign handle_list = null
  assign source = '-'

  # 1. Metaobject
  assign group = p.metafields.custom.model_group.value
  if group == blank
    assign group = p.metafields.custom.custom_model_group.value
  endif
  if group != blank
    if group.products != blank
      assign siblings = group.products.value
      assign source = 'metaobject.products'
    elsif group.model_code != blank
      assign siblings = group.model_code.value
      assign source = 'metaobject.model_code'
    endif
  endif

  # 2. Ürün listesi metafield'ı
  if siblings == blank and p.metafields.custom.color_siblings != blank
    assign siblings = p.metafields.custom.color_siblings.value
    assign source = 'custom.color_siblings'
  endif

  # 3. Handle listesi
  if siblings == blank and p.metafields.custom.model_variants != blank
    assign handle_list = p.metafields.custom.model_variants | split: ','
    assign source = 'custom.model_variants'
  endif

  # 4. Etiket -> koleksiyon
  assign model_tag = ''
  if siblings == blank and handle_list == blank
    assign tag_prefix = st.tag_prefix | default: 'model:' | downcase
    assign tag_prefix_size = tag_prefix | size
    for tag in p.tags
      assign tag_down = tag | downcase
      assign tag_start = tag_down | slice: 0, tag_prefix_size
      if tag_start == tag_prefix
        assign model_tag = tag_down | remove_first: tag_prefix | strip | handle
        break
      endif
    endfor
    if model_tag != blank
      assign collection_handle = st.collection_prefix | append: model_tag
      assign model_collection = collections[collection_handle]
      if model_collection.products_count > 0
        assign siblings = model_collection.products
        assign source = 'collection: ' | append: collection_handle
      endif
    endif
  endif

  assign max_items = st.products_to_show
  assign columns_desktop = st.columns_desktop
  assign columns_mobile = st.columns_mobile
  assign columns_mobile_int = columns_mobile | plus: 0
  assign columns_tablet = 2
  if columns_desktop == 1
    assign columns_tablet = 1
  elsif columns_desktop >= 4
    assign columns_tablet = 3
  endif
  assign columns_gap = st.columns_gap
  assign rows_gap = st.rows_gap
  assign layout_type = st.layout_type

  assign is_slide = false
  if layout_type == 'carousel' or st.carousel_on_mobile
    assign is_slide = true
  endif

  assign count = 0
  assign skip_styles = false
-%}

{%- capture list_items -%}
  {%- if siblings != blank -%}
    {%- for item in siblings -%}
      {%- liquid
        if count >= max_items
          break
        endif
        if item.id == p.id and st.include_current == false
          continue
        endif
        if st.hide_unavailable and item.available == false and item.id != p.id
          continue
        endif
        assign count = count | plus: 1
      -%}
      {%- render 'model-color-products-item',
        item: item,
        current: p,
        st: st,
        section_id: section.id,
        index: count,
        is_slide: is_slide,
        skip_styles: skip_styles
      -%}
      {%- assign skip_styles = true -%}
    {%- endfor -%}
  {%- elsif handle_list != blank -%}
    {%- for handle in handle_list -%}
      {%- liquid
        if count >= max_items
          break
        endif
        assign clean = handle | strip
        assign item = all_products[clean]
        if item == blank or item.id == blank
          continue
        endif
        if item.id == p.id and st.include_current == false
          continue
        endif
        if st.hide_unavailable and item.available == false and item.id != p.id
          continue
        endif
        assign count = count | plus: 1
      -%}
      {%- render 'model-color-products-item',
        item: item,
        current: p,
        st: st,
        section_id: section.id,
        index: count,
        is_slide: is_slide,
        skip_styles: skip_styles
      -%}
      {%- assign skip_styles = true -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if count == 0 and st.debug -%}
  <div style="border:1px solid red;padding:8px;font-size:12px;line-height:1.5" {{ block.shopify_attributes }}>
    <strong>Model renkleri (ürün kartları) — debug</strong><br>
    ürün: {{ p.title | default: 'YOK (closest.product boş)' }} / handle: {{ p.handle }}<br>
    kullanılan kaynak: {{ source }}<br>
    custom.model_group: {% if p.metafields.custom.model_group != blank %}EVET{% else %}HAYIR{% endif %}<br>
    custom.color_siblings: {% if p.metafields.custom.color_siblings != blank %}EVET{% else %}HAYIR{% endif %}<br>
    custom.model_variants: {{ p.metafields.custom.model_variants | default: '-' }}<br>
    model etiketi: {{ model_tag | default: '-' }} (koleksiyon: {{ st.collection_prefix }}{{ model_tag }})<br>
    Not: "Açık ürünü de göster" kapalıysa ve grupta sadece bu ürün varsa liste boş görünür.
  </div>
{%- endif -%}

{%- if count > 0 -%}
  {%- liquid
    assign show_mobile_slider = false
    if layout_type == 'grid' and st.carousel_on_mobile and count > columns_mobile_int
      assign show_mobile_slider = true
    endif

    assign enable_navigation = false
    if st.navigation == 'arrows-pagination' or st.navigation == 'arrows'
      assign enable_navigation = true
    endif
    assign enable_pagination = false
    if st.navigation == 'pagination' or st.navigation == 'arrows-pagination'
      assign enable_pagination = true
    endif
  -%}

  <div
    class="model-color-products related-products{% if st.show_divider %} model-color-products--divider{% endif %} spacing-style"
    style="{% render 'spacing-style', settings: st %}"
    {{ block.shopify_attributes }}
  >
    {%- if st.heading != blank -%}
      <p class="model-color-products__heading related-products__heading {{ st.heading_size }}">
        {{ st.heading }}
      </p>
    {%- endif -%}

    {%- if layout_type == 'carousel' -%}
      {%- capture breakpoints -%}
        {
          "750": { "slidesPerView": {{ columns_tablet }} },
          "1024": { "slidesPerView": {{ columns_tablet }} },
          "1400": { "slidesPerView": {{ columns_desktop }} }
        }
      {%- endcapture -%}
      <swiper-component
        class="collection-carousel-swiper-component"
        {%- render 'swiper-data',
          settings: st,
          slides_per_view: columns_mobile,
          space_between: columns_gap,
          watch_slides_progress: true,
          breakpoints: breakpoints
        -%}
        style="
          {% render 'swiper-style',
            columns_mobile: columns_mobile,
            columns_tablet: columns_tablet,
            columns_desktop: columns_desktop,
            columns_gap: columns_gap
          %}
        "
      >
        <div class="swiper w-full">
          <ul
            class="swiper-wrapper grid-layout-no-js list-unstyled lg:grid-layout--{{ columns_desktop }} md:grid-layout--{{ columns_tablet }} grid--{{ columns_mobile }}-col-mobile"
            role="list"
          >
            {{ list_items }}
          </ul>

          {%- if enable_pagination -%}
            <div class="swiper-pagination"></div>
          {%- endif -%}
          {%- if enable_navigation -%}
            <div class="swiper-btns-wrap small-hide swiper-btns-wrap--{{ st.arrows_position }}">
              {%- render 'swiper-button' -%}
            </div>
          {%- endif -%}
        </div>
      </swiper-component>
    {%- else -%}
      <div class="collection--grid-layout">
        {%- if show_mobile_slider -%}
          <swiper-component
            class="swiper-component-mobile"
            data-swiper-mobile
            {%- render 'swiper-data',
              settings: st,
              loop: false,
              slides_per_view: columns_mobile,
              space_between: columns_gap
            -%}
            style="
              {% render 'swiper-style',
                columns_mobile: columns_mobile,
                columns_tablet: columns_tablet,
                columns_desktop: columns_desktop,
                columns_gap: columns_gap
              %}
            "
          >
            <div class="swiper">
        {%- endif -%}

        <ul
          class="grid grid-layout list-unstyled{% if show_mobile_slider %} swiper-wrapper md:grid{% endif %} lg:grid-layout--{{ columns_desktop }} md:grid-layout--{{ columns_tablet }} sm:grid-layout--{{ columns_mobile }}"
          role="list"
          style="--grid-desktop-horizontal-spacing: {{ columns_gap }}px; --grid-desktop-vertical-spacing: {{ rows_gap }}px; --grid-mobile-horizontal-spacing: {{ columns_gap }}px; --grid-mobile-vertical-spacing: {{ rows_gap }}px;"
        >
          {{ list_items }}
        </ul>

        {%- if show_mobile_slider -%}
            </div>
          </swiper-component>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- style -%}
    .model-color-products--divider {
      border-top: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.12);
    }
    .model-color-products__heading {
      margin: 0 0 1.6rem;
    }
    .model-color-products__item {
      position: relative;
    }
    .model-color-products__current-badge {
      position: absolute;
      z-index: 3;
      inset-inline-start: 0.8rem;
      inset-block-start: 0.8rem;
      padding: 0.3rem 0.8rem;
      font-size: 1.1rem;
      line-height: 1.5;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      background: var(--color-foreground, #000);
      color: var(--color-background, #fff);
      pointer-events: none;
    }
    .model-color-products__item--current .card__media,
    .model-color-products__item--current .card__inner {
      outline: 1px solid var(--color-foreground, #000);
      outline-offset: -1px;
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Renk kartları (model)",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Aynı modelin diğer renklerini 'Related products' görünümünde gösterir. Ürünler; custom.model_group (metaobject), custom.color_siblings (ürün listesi), custom.model_variants (handle listesi) veya 'model:<ad>' etiketi ile gruplanır."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "Alte culori ale acestui model"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Başlık boyutu",
      "options": [
        { "value": "h6", "label": "Çok küçük" },
        { "value": "h5", "label": "Küçük" },
        { "value": "h4", "label": "Orta" },
        { "value": "h3", "label": "Büyük" }
      ],
      "default": "h5"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Üstte ince çizgi",
      "default": false
    },
    {
      "type": "header",
      "content": "Gruplama"
    },
    {
      "type": "checkbox",
      "id": "include_current",
      "label": "Açık olan ürünü de listede göster",
      "default": false
    },
    {
      "type": "text",
      "id": "current_badge_text",
      "label": "Açık ürün etiketi",
      "default": "Selectat",
      "visible_if": "{{ block.settings.include_current == true }}"
    },
    {
      "type": "checkbox",
      "id": "hide_unavailable",
      "label": "Stokta olmayan renkleri gizle",
      "default": false
    },
    {
      "type": "text",
      "id": "tag_prefix",
      "label": "Model etiketi öneki",
      "default": "model:",
      "info": "Örn. ürüne 'model:borderline' etiketi verin."
    },
    {
      "type": "text",
      "id": "collection_prefix",
      "label": "Model koleksiyonu handle öneki",
      "default": "model-",
      "info": "'model:borderline' etiketi -> 'model-borderline' handle'lı koleksiyon. Koşulu 'Etiket = model:borderline' olan otomatik koleksiyon oluşturun."
    },
    {
      "type": "header",
      "content": "Düzen"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Düzen tipi",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "Mobilde kaydırmalı",
      "default": true,
      "visible_if": "{{ block.settings.layout_type == 'grid' }}"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Maksimum ürün",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Masaüstü kolon sayısı",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobil kolon sayısı",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Yatay boşluk",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "Dikey boşluk",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 30,
      "visible_if": "{{ block.settings.layout_type == 'grid' }}"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Carousel döngü",
      "default": false,
      "visible_if": "{{ block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "navigation",
      "label": "Carousel navigasyonu",
      "options": [
        { "value": "none", "label": "Yok" },
        { "value": "arrows", "label": "Oklar" },
        { "value": "pagination", "label": "Sayfalama" },
        { "value": "arrows-pagination", "label": "Oklar + sayfalama" }
      ],
      "default": "arrows",
      "visible_if": "{{ block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "arrows_position",
      "label": "Ok konumu",
      "options": [
        { "value": "inside", "label": "İçeride" },
        { "value": "bottom", "label": "Altta" }
      ],
      "default": "inside",
      "visible_if": "{{ block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "Sayfalama tipi",
      "options": [
        { "value": "bullets", "label": "Noktalar" },
        { "value": "dynamic", "label": "Dinamik" },
        { "value": "progressbar", "label": "İlerleme çubuğu" },
        { "value": "fraction", "label": "Sayaç" }
      ],
      "default": "bullets",
      "visible_if": "{{ block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "Ürün kartı"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Görsel oranı",
      "options": [
        { "value": "adapt", "label": "Görsele uyarla" },
        { "value": "portrait", "label": "Dikey" },
        { "value": "square", "label": "Kare" }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Görsel şekli",
      "options": [
        { "value": "default", "label": "Varsayılan" },
        { "value": "round", "label": "Yuvarlak" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Hover'da ikinci görseli göster",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Markayı göster",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Ürün puanını göster",
      "default": true
    },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Hızlı ekle",
      "options": [
        { "value": "none", "label": "Yok" },
        { "value": "standard", "label": "Standart" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Diğer"
    },
    {
      "type": "checkbox",
      "id": "debug",
      "label": "Debug bilgisi göster (kurulum sonrası kapatın)",
      "default": false
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Üst boşluk",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Alt boşluk",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Renk kartları (model)",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
